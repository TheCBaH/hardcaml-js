opam-version: "2.0"
synopsis: "Hardcaml v0.17.1 with a pure OCaml Bits_arith for js_of_ocaml"
maintainer: "TheCBaH"
authors: ["Vladimir N. Silyaev" "Jane Street Group, LLC (Hardcaml)"]
license: "MIT"
homepage: "https://github.com/TheCBaH/hardcaml-js"
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.3.0"}
  "base" {>= "v0.17" & < "v0.18"}
  "bin_prot" {>= "v0.17" & < "v0.18"}
  "core_kernel" {>= "v0.17" & < "v0.18"}
  "ppx_jane" {>= "v0.17" & < "v0.18"}
  "ppx_sexp_conv" {>= "v0.17" & < "v0.18"}
  "stdio" {>= "v0.17" & < "v0.18"}
  "dune" {>= "3.11.0"}
  "ppxlib" {>= "0.36.0"}
  "zarith" {>= "1.11"}
  "zarith_stubs_js" {>= "v0.17" & < "v0.18"}
]
