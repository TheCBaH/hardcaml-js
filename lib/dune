; hardcaml/src with the patches in patches/ applied, plus the Bits_arith modules of this
; directory. dune.inc lists one rule per upstream file (copy, or patch if patches/ has
; <file>.patch); it is generated by gen/gen.ml, and `dune runtest` fails when it is stale
; (fix with `dune promote`).

(rule
 (targets dune.inc.gen)
 (deps
  (source_tree ../hardcaml/src)
  (source_tree patches))
 (action
  (with-stdout-to
   dune.inc.gen
   (run ./gen/gen.exe ../hardcaml/src patches))))

(rule
 (alias runtest)
 (action
  (diff dune.inc dune.inc.gen)))

(include dune.inc)

(library
 (foreign_stubs
  (language c)
  (names bits_stubs))
 (name hardcaml)
 (public_name hardcaml)
 (js_of_ocaml
  (javascript_files bits_stubs.js))
 ; Upstream's sources are not warning-clean under the dev profile.
 (flags
  (:standard -w -a))
 (libraries base bin_prot core_kernel.flags stdio zarith zarith_stubs_js)
 (preprocess
  (pps ppx_jane ppx_hardcaml0))
 (ocamlopt_flags
  :standard
  (:include ocamlopt-flags)))

(rule
 (targets ocamlopt-flags)
 (deps)
 (action
  (bash "echo '()' > ocamlopt-flags")))
